[0.928,"o","  templates    List and download Blazium export templates\r\n"]
[0.94,"o","  uninstall    Uninstall a registered Blazium editor\r\n"]
[0.952,"o","  update       Check for or apply Blazium product updates\r\n"]
[0.964,"o","  upgrade      Update blazium-cli from the CDN manifest\r\n"]
