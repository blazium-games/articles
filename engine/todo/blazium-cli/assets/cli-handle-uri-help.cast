[0.15,"o","$ blazium-cli handle-uri --help\r\n"]
[0.4,"o","Parses blazium:// URIs from the Hub or OS handlers and performs the matching act"]
[0.412,"o","ion.\r\n"]
[0.424,"o","\r\n"]
[0.436,"o","Supported forms:\r\n"]
[0.448,"o","  blazium://open?path=<path-or-file-url>\r\n"]
[0.46,"o","  blazium://load?path=<path-or-file-url>\r\n"]
[0.472,"o","  blazium://project/<url-encoded-path>\r\n"]
[0.484,"o","  blazium://install?version=<ver>&channel=<optional>&platform=&arch=&mono=\r\n"]
[0.496,"o","  blazium://register?path=<path>&version=&channel=&platform=&arch=&mono=\r\n"]
[0.508,"o","  blazium://hub  (or blazium:// with empty host)\r\n"]
[0.52,"o","\r\n"]
[0.532,"o","Usage:\r\n"]
[0.544,"o","  blazium-cli handle-uri <uri> [flags]\r\n"]
[0.556,"o","\r\n"]
[0.568,"o","Examples:\r\n"]
[0.58,"o","  blazium-cli handle-uri \"blazium://open?path=C%3A%5CGames%5CFoo\"\r\n"]
[0.592,"o","  blazium-cli handle-uri \"blazium://install?version=0.6.714\"\r\n"]
[0.604,"o","  blazium-cli handle-uri \"blazium://register?path=C%3A%5CEditors%5Cblazium.exe&v"]
[0.616,"o","ersion=0.6.714&channel=release\"\r\n"]
[0.628,"o","  blazium-cli handle-uri blazium://hub\r\n"]
[0.64,"o","\r\n"]
[0.652,"o","Flags:\r\n"]
[0.664,"o","      --crash-reporter string   Editor sidecar crash reporter executable (omitte"]
[0.676,"o","d: Hub sidecar under BLAZIUM if present)\r\n"]
[0.688,"o","  -h, --help                    help for handle-uri\r\n"]
[0.7,"o","\r\n"]
[0.712,"o","Global Flags:\r\n"]
[0.724,"o","      --format string   Output format: human, json, or tsv (default \"human\")\r\n"]
[0.736,"o","      --json            Emit JSON on stdout (shorthand for --format json; implie"]
[0.748,"o","s --quiet)\r\n"]
[0.76,"o","      --quiet           Suppress warnings and non-fatal notices\r\n"]
