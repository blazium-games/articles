[0.15,"o","$ blazium-cli remote --help\r\n"]
[0.4,"o","Talk to the remote_control module (GET/POST /v1/*) for status, command execution"]
[0.412,"o",", and gated eval.\r\n"]
[0.424,"o","\r\n"]
[0.436,"o","Usage:\r\n"]
[0.448,"o","  blazium-cli remote [command]\r\n"]
[0.46,"o","\r\n"]
[0.472,"o","Available Commands:\r\n"]
[0.484,"o","  autowork      Trigger Autowork and fetch results\r\n"]
[0.496,"o","  config        Get or set blazium-cli remote preferences\r\n"]
[0.508,"o","  debugger      Debugger status, stack, breakpoints, and clear\r\n"]
[0.52,"o","  doctor        Diagnose connectivity to remote_control\r\n"]
[0.532,"o","  enable        Enable remote_control in a Blazium project (project.godot settin"]
[0.544,"o","gs)\r\n"]
[0.556,"o","  errors        Fetch error/warning log entries\r\n"]
[0.568,"o","  eval          Evaluate using the configured default language (see remote confi"]
[0.58,"o","g eval-default)\r\n"]
[0.592,"o","  eval-gdscript Evaluate a GDScript expression on the remote instance\r\n"]
[0.604,"o","  eval-lua      Evaluate a Luau expression on the remote instance\r\n"]
[0.616,"o","  exec          Execute a named remote command\r\n"]
[0.628,"o","  failed-run    Bundle logs, debugger, Autowork, and evidence files\r\n"]
[0.64,"o","  instances     List active remote_control editor instances\r\n"]
[0.652,"o","  list          List commands registered on the connected instance\r\n"]
[0.664,"o","  logs          Fetch engine/editor logs (incremental via --since)\r\n"]
[0.676,"o","  snapshot      Capture an editor or playing-scene PNG snapshot\r\n"]
[0.688,"o","  status        Show connected editor/runtime status\r\n"]
[0.7,"o","\r\n"]
[0.712,"o","Flags:\r\n"]
[0.724,"o","      --discover           Scan local ports 6500-6520 for /v1/health\r\n"]
[0.736,"o","  -h, --help               help for remote\r\n"]
[0.748,"o","      --host string        Remote control host (default \"127.0.0.1\")\r\n"]
[0.76,"o","      --instance string    Target instance id (6-char)\r\n"]
[0.772,"o","      --port int           Remote control port (default 6507)\r\n"]
[0.784,"o","      --project string     Target project path or registered name\r\n"]
[0.796,"o","      --timeout duration   HTTP timeout (default 30s)\r\n"]
[0.808,"o","      --token string       Bearer token (or BLAZIUM_REMOTE_TOKEN)\r\n"]
[0.82,"o","\r\n"]
